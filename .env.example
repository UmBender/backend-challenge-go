# Local example values only. Copy to .env to override Compose defaults.

POSTGRES_PASSWORD=postgres
WALLET_OWNER_PASSWORD=wallet_owner
WALLET_APP_PASSWORD=wallet_app
KEYCLOAK_ADMIN_PASSWORD=admin
POSTGRES_HOST_PORT=5432
LOCALSTACK_HOST_PORT=4566
KEYCLOAK_HOST_PORT=8180

INSTANCE_ID=local-1
LOG_LEVEL=info
HTTP_ADDR=:8080
DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/wallet?sslmode=disable
DB_MAX_CONNS=10
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
START_TIMEOUT=30s
SHUTDOWN_TIMEOUT=25s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
OIDC_ISSUER=http://localhost:8180/realms/wagering
OIDC_JWKS_URL=http://localhost:8180/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
PENDING_REFERENCE_TTL=15m
PENDING_MAX_ATTEMPTS=10
PENDING_BACKOFF_BASE=1s
PENDING_BACKOFF_CAP=2m

# Integration tests only: superuser used to create and drop one database per test.
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
