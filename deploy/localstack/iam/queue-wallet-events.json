{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WalletServicePublishes",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::000000000000:user/wallet-service"
      },
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:wallet-events.fifo"
    },
    {
      "Sid": "EventConsumersRead",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::000000000000:user/events-consumer"
      },
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:wallet-events.fifo"
    }
  ]
}
