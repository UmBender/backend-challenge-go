{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResolveQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:000000000000:wager-transactions.fifo",
        "arn:aws:sqs:us-east-1:000000000000:wager-transactions-dlq.fifo",
        "arn:aws:sqs:us-east-1:000000000000:wallet-events.fifo"
      ]
    },
    {
      "Sid": "ConsumeWagerOperations",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:wager-transactions.fifo"
    },
    {
      "Sid": "ForwardPoisonMessages",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:000000000000:wager-transactions-dlq.fifo"
    },
    {
      "Sid": "PublishWalletEvents",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:000000000000:wallet-events.fifo"
    }
  ]
}
